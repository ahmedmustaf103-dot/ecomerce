# Contact page: recipient for mailto: drafts (your real inbox). If unset, the user must fill "To" in their mail app.
# VITE_CONTACT_EMAIL=you@example.com

# Optional: full URL to the API when the frontend is not served from the same origin.
# Leave empty when using Vite dev proxy (npm run dev + npm run dev:api) or production `npm start`.
# VITE_API_URL=http://localhost:3001

# SQLite database (path relative to the prisma/ folder). Creates prisma/dev.db by default.
DATABASE_URL="file:./dev.db"

# --- Firebase (optional) ---
# When VITE_FIREBASE_API_KEY and VITE_FIREBASE_PROJECT_ID are set, the app uses Firebase Auth +
# Firestore for products and orders. Otherwise it uses the REST `/api/products` flow and in-memory orders.
#
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Seed Firestore products (Firebase Admin — requires a service account JSON file):
# 1) Firebase Console → Project settings → Service accounts → Generate new private key
# 2) Either add to .env (loaded by npm run seed:firestore):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-service-account.json
#    or copy the JSON file to: private/serviceAccount.local.json
# 3) npm run seed:firestore

# Firebase Console → Authentication → Sign-in method:
# - Enable Email/Password
# - Enable Google (add support email & privacy policy URL if prompted)
# - Authentication → Settings → Authorized domains: add localhost and your Vercel domain
