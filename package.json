{
  "name": "ecommerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "dev:api": "prisma db push && node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "seed:firestore": "node scripts/seed-firestore-products.mjs",
    "preview": "vite preview",
    "postinstall": "prisma generate",
    "start": "NODE_ENV=production prisma db push && node server/index.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.12.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^13.8.0",
    "globals": "^17.4.0",
    "prisma": "^5.22.0",
    "vite": "^8.0.1"
  }
}
